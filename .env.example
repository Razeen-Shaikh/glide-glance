# Local Docker Compose database. Replace in production.
DATABASE_URL="postgresql://glide:glide@localhost:5434/glide_glance?schema=public"

# Auth.js session encryption. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth. Leave blank to hide Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# First admin created by prisma db seed.
ADMIN_EMAIL="admin@glideglance.test"
ADMIN_PASSWORD=""
SEED_CUSTOMER_EMAIL="customer@glideglance.test"
SEED_CUSTOMER_PASSWORD=""

# Razorpay test or live keys. Prepaid checkout stays unavailable until both are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Cloudinary. Without these, admin uploads are stored under public/uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend. Without a key, emails are printed to the server log in development.
RESEND_API_KEY=""
EMAIL_FROM="Glide Glance <orders@example.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bearer token for POST /api/cron/release-reservations
CRON_SECRET=""
